# Copy to server/.env and fill in. Never commit the real .env.
# Keys prefixed VITE_ are copied to front-end/.env.local by scripts/sync-env.js.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=8081
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# The application database on that cluster. Leave unset for universe-db.
# MONGO_DB_NAME=universe-db
# The cluster's storage cap, for `npm run cutover:check`. 512 on the free M0.
# ATLAS_STORAGE_LIMIT_MB=512
SERVER_URL=http://localhost:8081

# --- Tests ------------------------------------------------------------------
# The test suite writes, so it never uses MONGO_URI: it runs against its own
# server, a local MongoDB unless this says otherwise, and refuses the
# production cluster. Fill it with `npm run test:db:refresh`.
# TEST_MONGO_URI=mongodb://127.0.0.1:27017
# TEST_MONGO_DB_NAME=universe-db-test

# At least 16 characters, and no trailing semicolon. The server refuses to
# start in production without it, and warns otherwise.
SESSION_SECRET=

# Comma-separated list of origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:5173

# NOTE: do not end a value with a semicolon. dotenv keeps it as part of the
# value, so BYPASS_AUTH=true; reads as "true;" — which is not "true", so the
# flag is off by accident and tidying the file would silently turn it on. The
# server warns at startup if it finds any. The same bug broke password reset:
# SERVER_URL with a trailing ";" produced an unusable reset link, and
# EMAIL_USER/EMAIL_PASS with one failed SMTP authentication outright.

# --- Session cookie ---------------------------------------------------------
# The flags follow the transport, not NODE_ENV, because "production" says
# nothing about whether the app is served over TLS:
#
#   every ALLOWED_ORIGINS entry is https, and NODE_ENV=production
#       -> SameSite=None; Secure   (for a cross-site split-host deployment)
#   anything else, including a plain-http LAN deployment
#       -> SameSite=Lax;  not Secure
#
# This matters: a browser silently discards a Secure cookie sent over http, so
# forcing Secure on a LAN deployment makes sign-in appear to succeed while every
# request afterwards is unauthenticated. Override only if you know better.
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=false

# --- ERMS records module ---------------------------------------------------
# Gates the ERMS module. When false or absent its routes are not registered at
# all, which is the rollback for the whole module.
ERMS_MODULE_ENABLED=false

# --- HRPMS (Document Portal designations) ------------------------------------
# The portal's Designation box suggests the office's sections, units and
# divisions from HRPMS (employees.sectionOrUnit / .division). It reads the
# HRPMS database on the MONGO_URI cluster by default — nothing to set. Only if
# HRPMS lives elsewhere, give it its own connection; if that fails, the app
# falls back to the cluster, then to a short built-in list.
# HRPMS_DB_NAME=db-hrpms
# MONGO_URI_HRPMS=

# --- NAS / records share (SMB) ----------------------------------------------
# Service account used by the server to read the scanned-records share.
# Without these, /api/nas/* answers 503. Users never supply SMB credentials.
NAS_SHARE=\\\\10.14.76.167\\IDMS_Records_Database
NAS_USERNAME=
NAS_PASSWORD=
NAS_DOMAIN=EMBR3SYNOLOGY

# --- Mail -------------------------------------------------------------------
# Every email the application sends goes out from here: password reset and the
# notice after it, sign-up requests and their acknowledgement, new-account
# credentials, and the storage step-up code. For Gmail, EMAIL_PASS is an app
# password, not the account password. Without these, sign-up and account
# creation still work but no mail goes out (the API says so); password reset
# answers 503.
EMAIL_USER=
EMAIL_PASS=
# Defaults suit Gmail. Set for another provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# Where new sign-up requests are announced. Defaults to EMAIL_USER.
# ADMIN_NOTIFY_EMAIL=
# The origin links in email point at. Defaults to SERVER_URL, then the first
# ALLOWED_ORIGINS entry.
# CLIENT_URL=http://localhost:5173

# --- Optional ---------------------------------------------------------------
# Pins Node's c-ares resolver when a virtual adapter breaks mongodb+srv lookups.
# See server/config/dns.js.
# DNS_SERVERS=8.8.8.8,8.8.4.4
# Print a note when DNS falls back to TCP (silent by default; it is handled automatically).
# DNS_DEBUG=false

# Development only. The server refuses to start if this is true in production.
# BYPASS_AUTH=false

GOOGLE_APPLICATION_CREDENTIALS=
VITE_GOOGLE_MAPS_API_KEY=

# --- VERA, the in-app assistant ---------------------------------------------
# Master switch: no model call is made unless this is "true", whatever the
# in-app toggle says (VERA_ENABLED is also accepted and wins). Off, VERA still
# answers from its built-in help library, at no cost.
# AUTOMATION_AGENT_ENABLED=false
# One key per provider; choose the provider in Admin Settings › VERA Assistant.
# Keys are read only from here — never stored in the database or sent to a browser.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TEMPERATURE=0.2       (ignored by models that do not accept it)
# ANTHROPIC_TIMEOUT_MS=30000
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_TOKENS=1024
# GEMINI_TEMPERATURE=0.2
# GEMINI_TIMEOUT_MS=30000
# Messages per person per day, and for everyone per day (0 = unlimited).
# AUTOMATION_AGENT_USER_LIMIT=20
# AUTOMATION_AGENT_DAILY_LIMIT=100
# The sign-in page surface, per address: per minute and per day.
# VERA_PUBLIC_RATE_MAX=8
# VERA_PUBLIC_DAILY_MAX=60
# Model router (services/vera/provider.js). A model whose quota is spent, or
# that is down, rests until its quota resets and the next one answers. The
# Gemini free tier allows only a few requests a day PER MODEL, so the light
# model is a second, separate quota. Short help questions start there.
# GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite   (2.5-flash-lite is not available to every key)
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# ANTHROPIC_LIGHT_MODEL=claude-haiku-5-5
# VERA_MODEL_ROUTING=true            (false: every question to the main model)
# VERA_CROSS_PROVIDER_FALLBACK=true  (uses the other provider only if its key is set)
# Groq's free tier (no card, console.groq.com): OpenAI's GPT-OSS models. With
# the key set, legal questions go to GROQ_ACCURATE_MODEL first (it reasons
# before answering from the law text), and Groq joins the fallbacks before any
# paid provider. Groq does not read PDFs; scans stay with Gemini/Claude.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_ACCURATE_MODEL=openai/gpt-oss-120b
# GROQ_LIGHT_MODEL=openai/gpt-oss-20b
# Semantic cache: a rewording of a question already answered costs no request.
# VERA_SEMANTIC_CACHE=true
# VERA_CACHE_TTL_MS=43200000
# VERA_CACHE_MAX=500
# VERA_CACHE_SIMILARITY=0.8
