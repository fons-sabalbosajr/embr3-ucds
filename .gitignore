# Local database exports taken before destructive migration steps.
# May contain production data — never commit.
backups/

# Migration findings exported for Planning and Records. Contain proponent
# names and project titles, so they stay local like the extract itself.
reports/
# …but not source folders that happen to be called reports (the Universe
# Central DB's Reports page was never committed because of the line above).
!front-end/src/**/reports/
!server/**/reports/*.js

# Source data: the ERMS extract (~18k records with proponent names and
# addresses), the yearly UCDS spreadsheets, the NAS credentials workbook and
# the ERMS SQL backups. None of it belongs in git history.
data/

# Design notes and runbooks are kept locally, not versioned.
docs/

node_modules/
.env
.env.local
# Backups taken before editing .env hold the same secrets.
.env.bak*
.env.*.bak
