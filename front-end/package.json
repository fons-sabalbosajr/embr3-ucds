{
  "name": "front-end",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node ../scripts/sync-env.js && node ../scripts/check-client-env.js",
    "dev": "vite --host",
    "prebuild": "node ../scripts/sync-env.js && node ../scripts/check-client-env.js",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "purge:report": "purgecss --config purgecss.report.config.cjs",
    "check:fetch": "node scripts/check-fetch-credentials.mjs src"
  },
  "dependencies": {
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^2.8.10",
    "@react-google-maps/api": "^2.20.8",
    "@tanstack/react-query": "^5.102.8",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.23",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lodash": "^4.18.1",
    "lodash.debounce": "^4.0.8",
    "moment": "^2.30.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^4.10.38",
    "powerbi-client": "^2.24.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-highlight-words": "^0.21.0",
    "react-icons": "^5.7.0",
    "react-number-format": "^5.4.5",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.3",
    "styled-components": "^6.5.3",
    "sweetalert2": "^11.26.25",
    "sweetalert2-react-content": "^5.1.2"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "purgecss": "^6.0.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "path-to-regexp": "^8.4.2",
    "postcss-selector-parser": "^7.1.6"
  }
